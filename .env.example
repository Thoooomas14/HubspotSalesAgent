# OpenRouter API Key for LLM inference (e.g. anthropic/claude-3.5-sonnet, openai/gpt-4o)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tavily API Key for real-time web research on leads and companies
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith for agent observability and tracing (optional)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=hubspot-sales-agent

# HubSpot Private App Access Token (scopes needed: crm.objects.contacts.read/write, crm.objects.deals.read/write)
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here

# Agent Configuration
MODEL_NAME=openai/gpt-4o-mini
TEMPERATURE=0.2
LOG_LEVEL=INFO